# IMOBI CRM — produção self-host
# Copie para .env e substitua TODOS os placeholders. Nunca comite .env.
# Para o conjunto completo de opções, veja .env.hostgator.example.

NODE_ENV=production

APP_NAME=IMOBI CRM
APP_LOGO_URL=/imobi-logo.png
APP_ACCENT_HEX=#7B3FA4

NEXT_PUBLIC_APP_URL=https://crm.seudominio.com.br
NEXT_PUBLIC_ADMIN_URL=https://crm.seudominio.com.br
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=
SUPABASE_DB_ADMIN_URL=

INTERNAL_SECRET=
INTERNAL_CRON_SECRET=
CPF_ENCRYPTION_KEY=
WAHA_BYO_ENCRYPTION_KEY=
AI_CRED_AES_KEY=

WAHA_API_BASE_URL=http://waha:3000
WAHA_API_KEY=
WAHA_WEBHOOK_BASE_URL=https://crm.seudominio.com.br
WAHA_HMAC_SECRET=
WAHA_WEBHOOK_REQUIRE_SIGNATURE=false

UPSTASH_REDIS_REST_URL=http://srh:80
UPSTASH_REDIS_REST_TOKEN=

APP_IMAGE=ghcr.io/hudsonlcustodio/imobi-crm:stable
WORKER_IMAGE=ghcr.io/hudsonlcustodio/imobi-worker:stable
SCHEDULER_IMAGE=ghcr.io/hudsonlcustodio/imobi-scheduler:stable
APP_PULL_POLICY=always
WORKER_PULL_POLICY=always
SCHEDULER_PULL_POLICY=always

DOMAIN=crm.seudominio.com.br
ACME_EMAIL=voce@seudominio.com.br

SENTRY_DSN=off

# Opcionais conforme funcionalidades habilitadas
RESEND_API_KEY=
RESEND_FROM_EMAIL=
SUPPORT_EMAIL=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
